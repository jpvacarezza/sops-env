{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "DATABASE_URL": { "type": "string", "minLength": 1 },
    "SERVICE_KEY_WEB": { "type": "string", "minLength": 32 },
    "LOG_LEVEL": {
      "type": "string",
      "enum": ["debug", "info", "warn", "error"],
      "default": "info"
    },
    "PROXY_HOPS": { "type": "string", "default": "false" }
  },
  "required": ["DATABASE_URL", "SERVICE_KEY_WEB"]
}
