{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "API_URL": { "type": "string", "format": "uri" },
    "SERVICE_KEY": { "type": "string", "minLength": 32 },
    "LOG_LEVEL": {
      "type": "string",
      "enum": ["debug", "info", "warn", "error"],
      "default": "info"
    },
    "MONITORING_DSN": { "type": "string" }
  },
  "required": ["API_URL", "SERVICE_KEY"]
}
